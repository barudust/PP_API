# Copia este archivo a `.env` y ajusta los valores.
# `.env` está en .gitignore y NO se versiona.

# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5433/negocio

# --- Seguridad / JWT ---
# En producción usa un secreto largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=tu_secreto_super_seguro_cambialo_por_algo_largo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Orígenes del/los frontend(s) web, separados por coma.
# La app Android nativa NO necesita estar aquí.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Zona horaria para mostrar fechas ---
TIMEZONE=America/Mexico_City

# --- Reglas de negocio ---
# Sucursal por defecto para el atajo de "stock" al editar un producto.
SUCURSAL_DEFAULT=1
# Permitir que una venta deje el stock negativo (false = bloquea sobreventa).
PERMITIR_STOCK_NEGATIVO=false
